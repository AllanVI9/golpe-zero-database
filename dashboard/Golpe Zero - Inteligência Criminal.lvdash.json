{
  "datasets": [
    {
      "name": "1d42e73d",
      "displayName": "1 - Parameter Input Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(quantidade) AS total_ocorrencias,\r\n",
        "    COUNT(DISTINCT natureza) AS naturezas_monitoradas,\r\n",
        "    COUNT(DISTINCT mes) AS meses_analisados,\r\n",
        "    COUNT(DISTINCT ano) AS anos_analisados\r\n",
        "FROM golpe_zero.fato_ocorrencia;"
      ],
      "catalog": "workspace",
      "schema": "golpe_zero"
    },
    {
      "name": "d8920c54",
      "displayName": "2 - Top Ten Incident Types by Frequency Summary",
      "queryLines": [
        "SELECT\r\n",
        "    natureza,\r\n",
        "    SUM(quantidade) AS total_ocorrencias\r\n",
        "FROM golpe_zero.fato_ocorrencia\r\n",
        "GROUP BY natureza\r\n",
        "ORDER BY total_ocorrencias DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "0f631252",
      "displayName": "3 - Monthly Occurrences Summary Data",
      "queryLines": [
        "SELECT\r\n",
        "    CASE mes\r\n",
        "        WHEN 'Janeiro' THEN 1\r\n",
        "        WHEN 'Fevereiro' THEN 2\r\n",
        "        WHEN 'Março' THEN 3\r\n",
        "        WHEN 'Abril' THEN 4\r\n",
        "        WHEN 'Maio' THEN 5\r\n",
        "        WHEN 'Junho' THEN 6\r\n",
        "        WHEN 'Julho' THEN 7\r\n",
        "        WHEN 'Agosto' THEN 8\r\n",
        "        WHEN 'Setembro' THEN 9\r\n",
        "        WHEN 'Outubro' THEN 10\r\n",
        "        WHEN 'Novembro' THEN 11\r\n",
        "        WHEN 'Dezembro' THEN 12\r\n",
        "    END AS numero_mes,\r\n",
        "    mes,\r\n",
        "    SUM(quantidade) AS total_ocorrencias\r\n",
        "FROM golpe_zero.fato_ocorrencia\r\n",
        "GROUP BY mes\r\n",
        "ORDER BY numero_mes;"
      ]
    },
    {
      "name": "e06f02f6",
      "displayName": "4 - Elderly Population",
      "queryLines": [
        "SELECT\r\n",
        "    estado,\r\n",
        "    ano,\r\n",
        "    SUM(populacao_60_mais) AS populacao_60_mais\r\n",
        "FROM golpe_zero.dim_populacao\r\n",
        "GROUP BY estado, ano\r\n",
        "ORDER BY ano;"
      ]
    },
    {
      "name": "af2b5761",
      "displayName": "5 - Theft Indicators",
      "queryLines": [
        "WITH dados AS (\r\n",
        "\r\n",
        "    SELECT\r\n",
        "        natureza,\r\n",
        "        quantidade\r\n",
        "    FROM golpe_zero.fato_ocorrencia\r\n",
        "\r\n",
        "    WHERE UPPER(TRIM(natureza)) NOT LIKE 'TOTAL %'\r\n",
        "      AND UPPER(TRIM(natureza)) NOT LIKE 'Nº DE VÍTIMAS%'\r\n",
        "\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "\r\n",
        "    SUM(\r\n",
        "        CASE\r\n",
        "            WHEN UPPER(natureza) LIKE '%ROUBO%'\r\n",
        "            THEN quantidade\r\n",
        "            ELSE 0\r\n",
        "        END\r\n",
        "    ) AS registros_de_roubo,\r\n",
        "\r\n",
        "    SUM(quantidade) AS total_registros,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        100.0 * SUM(\r\n",
        "            CASE\r\n",
        "                WHEN UPPER(natureza) LIKE '%ROUBO%'\r\n",
        "                THEN quantidade\r\n",
        "                ELSE 0\r\n",
        "            END\r\n",
        "        ) / NULLIF(SUM(quantidade), 0),\r\n",
        "        2\r\n",
        "    ) AS percentual_roubos\r\n",
        "\r\n",
        "FROM dados;"
      ]
    }
  ],
